PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/deepfake_detection
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
SESSION_SECRET=session-encryption-secret-change-in-production

# Email Notifications (Configurable SMTP or Ethereal for testing)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Deepfake Detection Alert" <alerts@deepfakedetect.local>
ADMIN_EMAIL=admin@deepfakedetect.local

# Browser Automation (Playwright)
BROWSER_HEADLESS=true
BROWSER_PROFILE_PATH=./profiles
META_BROWSER_PROFILE_PATH=./profiles/meta
GROK_BROWSER_PROFILE_PATH=./profiles/grok
BROWSER_TIMEOUT_MS=45000
MAX_ANALYSIS_DURATION_SECONDS=120
CONCURRENT_ANALYSIS_LIMIT=2

# Security & Uploads
MAX_UPLOAD_SIZE_MB=50
MEDIA_RETENTION_DAYS=7
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Social Account Authorization (Analyst Media Verification - Optional)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5000/api/auth/x/callback
